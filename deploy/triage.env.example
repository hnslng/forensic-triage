# TRIAGE//BOX local configuration
# Installed as /etc/forensic-triage/triage.env (mode 0600).

# Keep 127.0.0.1 when access is provided through an SSH tunnel.
FORENSIC_TRIAGE_WEB_HOST=127.0.0.1
FORENSIC_TRIAGE_WEB_PORT=8787

# Operational data stays outside Git. Move CASEFILES_ROOT to encrypted storage
# before using the system with real case data.
FORENSIC_TRIAGE_RESULTS_ROOT=@PROJECT_ROOT@/results
FORENSIC_TRIAGE_CASEFILES_ROOT=@PROJECT_ROOT@/casefiles
FORENSIC_TRIAGE_WEB_ROOT=@PROJECT_ROOT@/web
FORENSIC_TRIAGE_PROFILE=@PROJECT_ROOT@/profiles/default.yaml

# A defective medium may never control the dashboard indefinitely. The first
# value limits one complete scan; the second limits each external media command.
FORENSIC_TRIAGE_SCAN_TIMEOUT_SECONDS=180
FORENSIC_TRIAGE_COMMAND_TIMEOUT_SECONDS=15

# ZIP-/ISO-Verzeichnisindex: höchstens drei Sekunden Zusatzaufwand je Medium,
# keine Extraktion und keine rekursive Prüfung verschachtelter Container.
FORENSIC_TRIAGE_CONTAINER_INDEX_SECONDS=3
FORENSIC_TRIAGE_CONTAINER_MAX_FILES=50
FORENSIC_TRIAGE_CONTAINER_MAX_ENTRIES=2000
FORENSIC_TRIAGE_CONTAINER_MAX_TOTAL_ENTRIES=10000

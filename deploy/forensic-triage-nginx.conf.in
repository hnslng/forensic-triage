# TRIAGE//BOX local reverse proxy. The scanner itself stays on 127.0.0.1:8787.
# Only hosts connected to the private TRIAGEBOX hotspot may reach the UI.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name triagebox.local triagebox;

    access_log /var/log/nginx/forensic-triage.access.log;
    error_log /var/log/nginx/forensic-triage.error.log warn;

    location / {
        allow 127.0.0.1;
        allow ::1;
        allow 10.42.0.0/24;
        deny all;

        proxy_pass http://127.0.0.1:@WEB_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 190s;
    }
}

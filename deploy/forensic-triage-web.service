[Unit]
Description=Forensic Triage local operator dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/triage/forensic-triage
ExecStart=/home/triage/forensic-triage/.venv/bin/forensic-triage-web --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

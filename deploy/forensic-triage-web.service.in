[Unit]
Description=TRIAGE//BOX local operator dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=@RUNTIME_ROOT@
EnvironmentFile=-/etc/forensic-triage/triage.env
ExecStart=@RUNTIME_ROOT@/.venv/bin/forensic-triage-web
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=10
PrivateMounts=true

[Install]
WantedBy=multi-user.target
